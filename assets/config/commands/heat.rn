// pub fn heat(state, toggle) {
//     Ok(())
// }

pub fn heat(state, toggle) {
    if toggle is bool {
        state.config.heat = toggle;
        Ok(())
    } else {
        Err(RuneCommandError::InvalidArgType {
            got: format!("{:?}", toggle),
            expected: ArgType::Boolean,
        })
    }
}
