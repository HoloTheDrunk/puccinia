### Default config file for the Puccinia IDE

## Properties

# Cell heat display toggle
set heat true;

# Cell heat attenuation over time in the range [0; 255]
set heat_diffusion 30;

# Live program output toggle (from , and . operators)
set live_output true;

# Program run display type (None, Partial or All)
set view_updates All;

# Additional sleep between steps
set step_ms 0;

## Bindings

# Escape
bind escape <Escape>;

# Cursor movement
bind left h;
bind down j;
bind up k;
bind right l;

# Expand grid
bind expand_left H;
bind expand_down J;
bind expand_up K;
bind expand_right L;

# Grid panning
bind pan_left ^h;
bind pan_down ^j;
bind pan_up ^k;
bind pan_right ^l;

# Mode switch
bind start_command <Colon>;
bind start_insert i;
bind start_visual v;
bind start_running ^r;
bind start_history u;

# Normal mode
bind paste p;
bind normal_breakpoint b;

# Command mode
bind submit_command <Enter>;

# Visual mode
bind yank y;
bind delete d;

# Running mode
bind stop_run ^c;
bind step <Space>;
bind run_breakpoint b;
bind skip_to_breakpoint <Enter>;

# Input mode (not insert mode, this is for input cells in running mode)
bind submit_input <Enter>;

# History mode
bind history_back u;
bind history_forward ^r;
bind history_accept <Enter>;
