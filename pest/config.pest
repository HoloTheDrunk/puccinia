COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }
WHITESPACE = _{ " " | "\t" | NEWLINE }

ALPHA_SNAKE = _{ (ASCII_ALPHA | "_") }
ALNUM_SNAKE = _{ (ASCII_ALPHANUMERIC | "_") }

config = _{ SOI ~ statement* ~ EOI }
statement = _{ set | bind }

set = { "set" ~ identifier ~ value }
bind = { "bind" ~ identifier ~ keyEvent }

identifier = @{ ALPHA_SNAKE ~ ALNUM_SNAKE* }
value = @{ (!NEWLINE ~ ANY)+ }
keyEvent = @{
  "^"? ~ (("<" ~ special_key ~ ">") | key)
}
key = { ASCII }
special_key = @{ ALNUM_SNAKE+ }
