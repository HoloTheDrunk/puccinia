### Default config file for the Puccinia IDE

## Properties

# Cache directory for autosaves, I recommend changing it to an absolute canonical path
set cache_dir .cache

# In megabytes, automatically removes oldest autosaves when the cache exceeds this size
set cache_dir_size 10

# In seconds
set autosave_interval 60

# Cell heat display toggle
set heat true

# Cell heat attenuation over time in the range [0; 255]
set heat_diffusion 30

# Live program output toggle (from , and . operators)
set live_output true

# Program run display type (None, Partial or All)
set view_updates All

# Additional sleep between steps
set step_ms 0

## Bindings

bind escape <Escape>

bind cycle_layout <Tab>

bind backspace <Backspace>
bind delete_current <Delete>
bind delete_word ^w

# Cursor movement
bind left h
bind down j
bind up k
bind right l

# Expand grid
bind expand_left H
bind expand_down J
bind expand_up K
bind expand_right L

# Grid panning
bind pan_left ^h
bind pan_down ^j
bind pan_up ^k
bind pan_right ^l

# Mode switch
bind start_command :
bind start_insert i
bind start_visual v
bind start_running ^r
bind start_history u

# Normal mode
bind paste p

# Visual mode
bind yank y
bind delete d

# Running mode
bind stop_run ^c
bind step <Space>
bind skip_to_breakpoint <Enter>

# Normal and Running modes
bind toggle_breakpoint b

# Command mode
bind submit_command <Enter>
bind command_history_up <Up>
bind command_history_down <Down>

# Input mode (not insert mode, this is for input cells in running mode)
bind submit_input <Enter>

# History mode
bind history_back u
bind history_forward ^r
bind history_accept <Enter>

## Commands

# Toggle heat
command heat = heat:
  @visible: Boolean@
  Toggle heat display
!command

command identity = identity:
  @value: Any@
!command
